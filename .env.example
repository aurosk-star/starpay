# 应用配置
APP_NAME=payment-gateway
APP_ENV=local
HTTP_ADDR=:8080

# 数据库驱动：postgres 或 mysql。
# 默认的 Docker Compose 启动 PostgreSQL。MySQL 已接入配置和驱动，
# 但 Ent 迁移与表结构兼容性需要单独验证后再正式使用。
DB_DRIVER=postgres

# 本地开发优先使用拆分字段，便于直接改端口、账号和库名。
# 如果设置了 DATABASE_URL，则会优先使用 DATABASE_URL。
DB_HOST=localhost
DB_PORT=15434
DB_NAME=payment_gateway
DB_USER=payment
DB_PASSWORD=payment
DB_SSLMODE=disable
# DATABASE_URL=postgres://payment:payment@localhost:15434/payment_gateway?sslmode=disable
# DATABASE_URL=payment:payment@tcp(localhost:3306)/payment_gateway?parseTime=true&charset=utf8mb4&loc=Local

# Docker Compose 宿主机映射端口。
HTTP_PORT=8080
POSTGRES_PORT=15434
REDIS_PORT=16380

# Redis 配置
REDIS_ADDR=localhost:16380
REDIS_PASSWORD=

# 管理员认证
JWT_SECRET=local-development-secret-change-me
ACCESS_TOKEN_TTL=12h
REFRESH_TOKEN_TTL=168h
REFRESH_COOKIE_NAME=pg_refresh_token
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAME_SITE=lax

# 应用请求签名密钥加密 Key：必须是 16、24 或 32 字节。
# 生产环境必须替换为独立随机值；已有应用更换该值后需要重置应用密钥。
APP_SECRET_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# 订单超时配置
# 业务方不传订单过期时间，支付网关按该 TTL 自动生成 expires_at。
ORDER_DEFAULT_TTL=15m
# 扫描待支付订单是否超时的间隔。
ORDER_EXPIRE_SCAN_INTERVAL=30s
# 每次扫描最多关闭的超时待支付订单数量。
ORDER_EXPIRE_SCAN_LIMIT=100
# 本进程启动的过期订单 Redis 队列消费者数量。
ORDER_EXPIRE_WORKER_CONCURRENCY=2
