# 生产环境配置模板
# 使用方式：
# 1. cp .env.production.example .env.production
# 2. 替换所有 CHANGE_ME_* 值
# 3. docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build

# 应用配置
APP_NAME=payment-gateway
APP_ENV=production
HTTP_ADDR=:8080
# 仅暴露给本机 Nginx 反向代理，不建议直接暴露公网。
HTTP_BIND=127.0.0.1
HTTP_PORT=8080

# PostgreSQL 配置
DB_DRIVER=postgres
POSTGRES_DB=payment_gateway
POSTGRES_USER=payment
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
DB_HOST=postgres
DB_PORT=5432
DB_NAME=${POSTGRES_DB}
DB_USER=${POSTGRES_USER}
DB_PASSWORD=${POSTGRES_PASSWORD}
DB_SSLMODE=disable
# 如使用云数据库，可改用 DATABASE_URL，并在 docker-compose.prod.yml 中移除 postgres 服务。
# DATABASE_URL=postgres://payment:CHANGE_ME_POSTGRES_PASSWORD@postgres:5432/payment_gateway?sslmode=disable

# Redis 配置
REDIS_ADDR=redis:6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# 管理员认证
JWT_SECRET=CHANGE_ME_RANDOM_LONG_JWT_SECRET
ACCESS_TOKEN_TTL=12h
REFRESH_TOKEN_TTL=168h
REFRESH_COOKIE_NAME=pg_refresh_token
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAME_SITE=lax

# 应用请求签名密钥加密 Key：必须是 16、24 或 32 字节。
# 生产环境必须替换为独立随机值；已有应用更换该值后需要重置应用密钥。
APP_SECRET_ENCRYPTION_KEY=CHANGE_ME_APP_SECRET_ENCRYPTION_KEY

# 订单超时配置
# 业务方不传订单过期时间，支付网关按该 TTL 自动生成 expires_at。
ORDER_DEFAULT_TTL=15m
# 扫描待支付订单是否超时的间隔。
ORDER_EXPIRE_SCAN_INTERVAL=30s
# 每次扫描最多关闭的超时待支付订单数量。
ORDER_EXPIRE_SCAN_LIMIT=100
# 本进程启动的过期订单 Redis 队列消费者数量。
ORDER_EXPIRE_WORKER_CONCURRENCY=2
